{
  "name": "mycareer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:skill-tree && npm run test:curriculum && npm run test:typescript-curriculum && npm run test:typescript-compile-gate && npm run test:python-curriculum && npm run test:python-runtime-curriculum && npm run test:migration && npm run test:mastery-decay && npm run test:lesson-units && npm run test:lesson-context && npm run test:review-session && npm run test:practice-llm && npm run test:practice-runtime && npm run test:draft-preview && npm run test:draft-pilot-feedback",
    "test:skill-tree": "tsx --env-file-if-exists=.env src/lib/skill-tree.selfcheck.ts",
    "test:curriculum": "tsx --env-file-if-exists=.env src/db/seed-skill-tree.selfcheck.ts",
    "test:integration": "tsx --env-file=.env src/db/multi-path-api.integration.ts",
    "test:javascript-curriculum": "tsx --env-file=.env src/db/javascript-curriculum.integration.ts",
    "test:javascript-generation": "tsx --env-file=.env src/db/javascript-labs-generation.integration.ts",
    "test:typescript-curriculum": "tsx --env-file-if-exists=.env src/db/typescript-curriculum.selfcheck.ts",
    "test:typescript-compile-gate": "tsx src/lib/practice-session/typescript-compile-gate.selfcheck.ts",
    "test:typescript-curriculum-integration": "tsx --env-file=.env src/db/typescript-curriculum.integration.ts",
    "test:typescript-generation": "tsx --env-file=.env src/db/typescript-labs-generation.integration.ts",
    "test:python-curriculum": "tsx --env-file-if-exists=.env src/db/python-curriculum.selfcheck.ts",
    "test:python-runtime-curriculum": "tsx --env-file-if-exists=.env src/lib/practice-session/python-curriculum-runtime.selfcheck.ts",
    "test:python-curriculum-integration": "tsx --env-file=.env src/db/python-curriculum.integration.ts",
    "test:python-generation": "tsx --env-file=.env src/db/python-labs-generation.integration.ts",
    "test:draft-preview-integration": "tsx --env-file=.env src/db/draft-preview.integration.ts",
    "test:migration": "tsx src/db/multi-path-migration.selfcheck.ts",
    "test:mastery-decay": "tsx --env-file-if-exists=.env src/lib/mastery-decay.selfcheck.ts",
    "test:lesson-units": "tsx --env-file-if-exists=.env src/lib/lesson-session/units.selfcheck.ts",
    "test:lesson-context": "tsx --env-file-if-exists=.env src/lib/lesson-session/context.selfcheck.ts",
    "test:review-session": "tsx --env-file-if-exists=.env src/lib/review-session.selfcheck.ts",
    "test:practice-llm": "tsx --env-file-if-exists=.env src/lib/practice-session/llm.selfcheck.ts",
    "test:practice-runtime": "tsx --env-file-if-exists=.env src/lib/practice-session/runtime.selfcheck.ts",
    "test:draft-preview": "tsx src/lib/draft-preview.selfcheck.ts",
    "test:draft-pilot-feedback": "tsx src/lib/draft-pilot-feedback.selfcheck.ts",
    "test:db": "tsx --env-file=.env src/lib/llm-limit.selfcheck.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.23",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@gsap/react": "^2.1.2",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.22",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
